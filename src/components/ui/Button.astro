---
/**
 * Pill button. Primary = coral fill, secondary = navy outline, ghost = text +
 * sky tint, onNavy = white pill for dark sections. One primary per view.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'onNavy';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const cls = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
---

<Tag
  class={cls}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={disabled ? 'true' : undefined}
  {...rest}
>
  <slot name="icon-left" />
  <slot />
  <slot name="icon-right" />
</Tag>

<style>
  .btn {
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    letter-spacing: 0.02em;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }

  .btn--sm { font-size: var(--fs-sm); padding: 9px 18px; }
  .btn--md { font-size: var(--fs-body); padding: 13px 26px; }
  .btn--lg { font-size: 1.0625rem; padding: 16px 34px; }

  .btn--primary { background: var(--accent-primary); color: #fff; }
  .btn--primary:hover { background: var(--accent-primary-hover); color: #fff; }

  .btn--secondary { background: transparent; color: var(--navy-700); border-color: var(--navy-700); }
  .btn--secondary:hover { background: var(--navy-700); color: #fff; }

  .btn--ghost { background: transparent; color: var(--navy-700); }
  .btn--ghost:hover { background: var(--sky-100); color: var(--navy-700); }

  .btn--onNavy { background: #fff; color: var(--navy-800); }
  .btn--onNavy:hover { background: var(--sky-100); color: var(--navy-800); }

  .btn[disabled], .btn[aria-disabled='true'] { opacity: 0.5; cursor: not-allowed; }

  .btn :global(svg) { width: 1em; height: 1em; }
</style>
