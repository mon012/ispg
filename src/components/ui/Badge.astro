---
/** Compact status / category chip. */
interface Props {
  tone?: 'navy' | 'coral' | 'gold' | 'sky' | 'solid' | 'onNavy';
  class?: string;
}
const { tone = 'navy', class: className = '' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: var(--r-pill);
  }
  .badge--navy   { background: var(--sky-100); color: var(--navy-700); }
  .badge--coral  { background: #fbe4df; color: var(--coral-600); }
  .badge--gold   { background: #fbeecb; color: #9a6b09; }
  .badge--sky    { background: var(--sky-100); color: var(--sky-600); }
  .badge--solid  { background: var(--navy-700); color: #fff; }
  .badge--onNavy { background: rgba(255,255,255,.14); color: var(--sky-300); }
</style>
