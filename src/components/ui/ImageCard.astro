---
/**
 * Rounded photo card with a caption overlaid at the base and a soft protection
 * gradient so the label stays legible on any photograph.
 */
interface Props {
  src: string;
  alt?: string;
  label?: string;
  eyebrow?: string;
  ratio?: string;
  href?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt = '',
  label,
  eyebrow,
  ratio = '3 / 4',
  href,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag class:list={['imgcard', className]} href={href} style={`--ratio:${ratio}`}>
  <img src={src} alt={alt} loading={loading} decoding="async" />
  {label && (
    <div class="imgcard__overlay">
      {eyebrow && <span class="imgcard__eyebrow">{eyebrow}</span>}
      <span class="imgcard__label">{label}</span>
    </div>
  )}
</Tag>

<style>
  .imgcard {
    position: relative;
    display: block;
    aspect-ratio: var(--ratio);
    border-radius: var(--r-lg);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--dur-base) var(--ease-standard);
    background: var(--sky-100);
  }
  .imgcard:hover { box-shadow: var(--shadow-lg); }

  .imgcard img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .imgcard:hover img { transform: scale(1.05); }

  .imgcard__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    padding: var(--sp-6);
    background: linear-gradient(
      to top,
      rgba(13, 41, 66, 0.78) 0%,
      rgba(13, 41, 66, 0.15) 45%,
      rgba(13, 41, 66, 0) 70%
    );
  }
  .imgcard__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--sky-300);
  }
  .imgcard__label {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-h2);
    line-height: 1.1;
    color: #fff;
  }
</style>
