---
import Button from '../ui/Button.astro';
import { mainNav, contact } from '../../data/site';

interface Props {
  /** Transparent, floating over a dark hero — used on pages that open with one. */
  floating?: boolean;
}
const { floating = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (item: (typeof mainNav)[number]) =>
  path === item.href ||
  (item.href !== '/' && path.startsWith(item.href)) ||
  (item.children ?? []).some((c) => path === c.href);
---

<header class:list={['hdr', floating && 'hdr--floating']} data-header>
  <div class="hdr__inner container">
    <a class="brand" href="/" aria-label={`${'International School of Phangan'} — home`}>
      <img class="brand__crest" src="/media/brand/ispg-crest.webp" alt="" width="47" height="52" />
      <span class="brand__text">
        <span class="brand__name">International School</span>
        <span class="brand__sub">Of Pha Ngan</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {mainNav.map((item) => (
          <li class:list={['nav__item', item.children && 'has-menu']}>
            <a
              class:list={['nav__link', isActive(item) && 'is-active']}
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
              {item.children && (
                <svg class="nav__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              )}
            </a>
            {item.children && (
              <div class="menu">
                <ul class="menu__list">
                  {item.children.map((c) => (
                    <li>
                      <a class="menu__link" href={c.href}>
                        <span class="menu__label">{c.label}</span>
                        {c.note && <span class="menu__note">{c.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__cta">
      <Button variant={floating ? 'onNavy' : 'primary'} size="sm" href="/contact/">Book a Visit</Button>
    </div>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
      <span class="burger__box" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="sr-only">Menu</span>
    </button>
  </div>

  <div class="mnav" id="mobile-nav" hidden data-mobile-nav>
    <nav class="container" aria-label="Mobile">
      <ul class="mnav__list">
        {mainNav.map((item) => (
          <li>
            <a class="mnav__link" href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="mnav__sub">
                {item.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mnav__foot">
        <Button variant="primary" href="/contact/">Book a Visit</Button>
        <a class="mnav__phone" href={contact.phoneHref}>{contact.phoneDisplay}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(251, 250, 246, 0.88);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border-hairline);
    transition: background var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard);
  }
  /* Floating: transparent over the hero until the page is scrolled. */
  .hdr--floating {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: rgba(255, 255, 255, 0.18);
  }
  .hdr--floating.is-pinned {
    background: rgba(251, 250, 246, 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom-color: var(--border-hairline);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    padding-block: 13px;
    min-height: var(--header-h);
  }

  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
  /* 8% larger than the previous 48px — still fits inside the fixed 78px
     header (13px padding-block either side), so the header itself doesn't grow. */
  .brand__crest { height: 52px; width: auto; display: block; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand__name {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 22px;
    letter-spacing: 0.04em;
    color: var(--navy-700);
  }
  .brand__sub {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .nav { margin-left: auto; }
  .nav__list { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; align-items: center; }
  .nav__item { position: relative; }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.01em;
    color: var(--navy-700);
    text-decoration: none;
    padding: 9px 12px;
    border-radius: var(--r-pill);
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .nav__link:hover { background: var(--sky-100); color: var(--navy-700); }
  .nav__link.is-active { color: var(--accent-primary); }

  .nav__chev { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: .6; transition: transform var(--dur-fast) var(--ease-standard); }
  .nav__item.has-menu:hover .nav__chev, .nav__item.has-menu:focus-within .nav__chev { transform: rotate(180deg); }

  .menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 268px;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--sp-2);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard), visibility var(--dur-fast);
  }
  .nav__item.has-menu:hover .menu,
  .nav__item.has-menu:focus-within .menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  /* Bridge the gap so the pointer can travel into the menu. */
  .nav__item.has-menu::after { content: ''; position: absolute; inset: 100% 0 auto; height: 12px; }

  .menu__list { list-style: none; margin: 0; padding: 0; }
  .menu__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    border-radius: var(--r-md);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .menu__link:hover { background: var(--sky-100); }
  .menu__label { font-size: 14px; font-weight: var(--fw-semibold); color: var(--navy-700); }
  .menu__note { font-size: 12px; color: var(--text-caption); line-height: 1.35; }

  .hdr__cta { flex-shrink: 0; }

  /* Floating variant: light-on-dark chrome. */
  .hdr--floating:not(.is-pinned) .brand__name { color: #fff; }
  .hdr--floating:not(.is-pinned) .brand__sub { color: rgba(255, 255, 255, 0.85); }
  .hdr--floating:not(.is-pinned) .nav__link { color: rgba(255, 255, 255, 0.9); }
  .hdr--floating:not(.is-pinned) .nav__link:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }
  .hdr--floating:not(.is-pinned) .nav__link.is-active { color: #fff; }
  .hdr--floating:not(.is-pinned) .burger__box span { background: #fff; }

  /* The CTA is built as onNavy so it reads over the hero image, but that white
     pill vanishes against the cream bar once the header pins — every other bit
     of floating chrome reverts above, so the button has to as well. */
  .hdr--floating.is-pinned :global(.btn--onNavy) {
    background: var(--accent-primary);
    color: #fff;
  }
  .hdr--floating.is-pinned :global(.btn--onNavy:hover) {
    background: var(--accent-primary-hover);
    color: #fff;
  }

  /* ------------------------------------------------------------ mobile */
  .burger {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    padding: 10px;
    cursor: pointer;
    border-radius: var(--r-sm);
  }
  .burger__box { display: grid; gap: 5px; width: 22px; }
  .burger__box span {
    display: block;
    height: 2px;
    background: var(--navy-700);
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease-standard), opacity var(--dur-fast) var(--ease-standard);
  }
  .burger[aria-expanded='true'] .burger__box span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] .burger__box span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] .burger__box span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .mnav {
    background: var(--paper);
    border-top: 1px solid var(--border-hairline);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-block: var(--sp-6) var(--sp-8);
  }
  .mnav[hidden] { display: none; }
  .mnav__list { list-style: none; margin: 0; padding: 0; }
  .mnav__link {
    display: block;
    padding: 13px 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--fw-semibold);
    color: var(--navy-700);
    text-decoration: none;
    border-bottom: 1px solid var(--border-hairline);
  }
  .mnav__sub { list-style: none; margin: 0 0 var(--sp-4); padding: var(--sp-3) 0 0; display: grid; gap: 10px; }
  .mnav__sub a { font-size: 15px; color: var(--text-muted); text-decoration: none; }
  .mnav__sub a:hover { color: var(--accent-primary); }
  .mnav__foot { display: flex; align-items: center; gap: var(--sp-5); margin-top: var(--sp-6); flex-wrap: wrap; }
  .mnav__phone { font-weight: var(--fw-semibold); color: var(--navy-700); }

  @media (max-width: 1080px) {
    .nav, .hdr__cta { display: none; }
    .burger { display: block; flex-shrink: 0; }
    /* Let the wordmark yield (and ellipsize) instead of pushing the burger
       past the viewport edge — its rendered width shifts with font-swap
       (Cormorant Garamond vs. the Georgia fallback) right up until the
       webfont loads. */
    .brand { flex-shrink: 1; min-width: 0; }
    .brand__text { min-width: 0; }
    .brand__name, .brand__sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }
  @media (min-width: 1081px) {
    .mnav { display: none !important; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  // Floating header solidifies once the hero has scrolled past.
  if (header?.classList.contains('hdr--floating')) {
    const onScroll = () => header.classList.toggle('is-pinned', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (mobileNav) mobileNav.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
    header?.classList.toggle('is-pinned', !open);
  });

  // Close the panel when the viewport grows past the mobile breakpoint.
  window.matchMedia('(min-width: 1081px)').addEventListener('change', (e) => {
    if (!e.matches) return;
    burger?.setAttribute('aria-expanded', 'false');
    if (mobileNav) mobileNav.hidden = true;
    document.body.style.overflow = '';
  });
</script>
