---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import ExploreLinks from '../components/sections/ExploreLinks.astro';
import { Image } from 'astro:assets';
import { teachers, departments } from '../data/teachers';
import { img } from '../lib/images';
import { cam } from '../data/accreditation';

const grouped = departments
  .map((d) => ({ department: d, people: teachers.filter((t) => t.department === d) }))
  .filter((g) => g.people.length > 0);

/** Only what the modal reads — the grid renders the rest from the server. */
const profiles = teachers.map(({ id, name, role, photoHero, bio, quote, quoteLabel, facts }) => ({
  id,
  name,
  role,
  photoHero: img(photoHero)?.src ?? photoHero,
  bio,
  quote,
  quoteLabel,
  facts,
}));
---

<BaseLayout
  title="Our Teachers & Leadership Team"
  description="Meet the people your child spends the day with — the ISPG founding team of international leadership, primary teachers and specialists on Koh Phangan."
  image="/media/teachers/team-hero.webp"
>
  <PageHero
    eyebrow="Our founding team"
    title="The people your child will <em>spend their days with</em>"
    lead="Small classes mean every teacher knows every child — not as a name on a register, but as a person with a particular way of getting stuck and a particular way of getting unstuck. Click a photo to read their full profile."
    image="/media/teachers/team-hero.webp"
  />

  {/* ----------------------------------------------------------- staff */}
  {grouped.map((group, gi) => (
    <section class:list={['section', 'dept', gi % 2 === 1 && 'alt']}>
      <div class="container">
        <div class="dept__head" data-reveal>
          <h2 class="dept__title">{group.department}</h2>
          <span class="dept__count">{group.people.length} {group.people.length === 1 ? 'person' : 'people'}</span>
        </div>

        <ul class="people">
          {group.people.map((t, i) => (
            <li data-reveal data-reveal-delay={i * 60}>
              <button class="person" type="button" data-person={t.id} aria-haspopup="dialog">
                <span class="person__photo">
                  {/* The opening row of the first department sits above the
                      fold — lazy-loading it delays the LCP instead of saving
                      anything. Everything further down stays lazy. */}
                  <Image
                    src={img(t.photo)!}
                    alt={`${t.name}, ${t.role} at ISPG`}
                    widths={[140, 280]}
                    sizes="140px"
                    loading={gi === 0 && i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                <span class="person__name">{t.name}</span>
                <span class="person__role">{t.role}</span>
                <span class="person__more">View profile</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  {/* Modal shell — populated from the button that opened it. */}
  <dialog class="modal" data-modal aria-labelledby="modal-name">
    <div class="modal__inner">
      <button class="modal__close" type="button" data-modal-close aria-label="Close">&times;</button>

      <div class="modal__photo">
        <img data-modal-photo alt="" decoding="async" />
      </div>

      <div class="modal__body">
        <h2 id="modal-name" data-modal-name></h2>
        <p class="modal__role" data-modal-role></p>

        <blockquote class="modal__quote" data-modal-quote hidden>
          <p class="modal__quote-label" data-modal-quote-label></p>
          <p data-modal-quote-text></p>
        </blockquote>

        <div class="modal__bio" data-modal-bio></div>

        <dl class="modal__facts" data-modal-facts></dl>
      </div>
    </div>
  </dialog>

  <ExploreLinks
    alt
    eyebrow="More about the school"
    title="Where they <em>teach</em>"
    items={[
      { title: 'Our story & campus', body: 'How ISPG began, and the site it grew on.', href: '/about/' },
      { title: 'Our FLAIR approach', body: 'The five commitments every teacher plans against.', href: '/flair/' },
      { title: 'Academics', body: `${cam('The Cambridge pathway', 'The academic pathway')} they deliver, from age 2 to 11.`, href: '/academics/' },
      { title: 'How to apply', body: 'Six steps to joining their classrooms.', href: '/admission/' },
    ]}
  />

  <CtaBand
    eyebrow="Meet us"
    title="Come and meet the <em>team</em>"
    lead="A tour includes time with the teachers for your child’s stage — not just the admissions office."
  />
</BaseLayout>

<script define:vars={{ profiles }}>
  const modal = document.querySelector('[data-modal]');
  const byId = Object.fromEntries(profiles.map((t) => [t.id, t]));
  let lastFocused = null;

  document.querySelectorAll('[data-person]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const t = byId[btn.dataset.person];
      if (!t || !modal) return;
      lastFocused = btn;

      const photo = modal.querySelector('[data-modal-photo]');
      photo.src = t.photoHero;
      photo.alt = `${t.name}, ${t.role} at ISPG`;

      modal.querySelector('[data-modal-name]').textContent = t.name;
      modal.querySelector('[data-modal-role]').textContent = t.role;
      modal.querySelector('[data-modal-bio]').innerHTML = `<p>${t.bio}</p>`;

      const q = modal.querySelector('[data-modal-quote]');
      q.hidden = !t.quote;
      if (t.quote) {
        modal.querySelector('[data-modal-quote-label]').textContent = t.quoteLabel ?? '';
        modal.querySelector('[data-modal-quote-text]').textContent = `“${t.quote}”`;
      }

      const facts = modal.querySelector('[data-modal-facts]');
      facts.innerHTML = (t.facts ?? [])
        .map((f) => `<div><dt>${f.label}</dt><dd>${f.value}</dd></div>`)
        .join('');

      modal.showModal();
      modal.querySelector('.modal__inner').scrollTop = 0;
    });
  });

  const closeModal = () => {
    modal?.close();
    lastFocused?.focus();
  };

  modal?.querySelector('[data-modal-close]')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  modal?.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeModal();
  });
</script>

<style>
  .dept__head { display: flex; align-items: baseline; gap: var(--sp-4); margin-bottom: var(--sp-8); }
  .dept__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--fs-display-3);
    color: var(--navy-700);
  }
  .dept__count { font-size: var(--fs-sm); color: var(--text-caption); }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--sp-8) var(--sp-6);
  }
  .person {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    background: none;
    border: 0;
    padding: var(--sp-4) var(--sp-3);
    border-radius: var(--r-lg);
    cursor: pointer;
    font: inherit;
    transition: background var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
  }
  .person:hover { background: var(--sky-100); transform: translateY(-2px); }

  .person__photo {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 14px;
    box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--line-300), var(--shadow-sm);
    transition: box-shadow var(--dur-base) var(--ease-standard);
  }
  .person:hover .person__photo { box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--sky-400), var(--shadow-md); }
  .person__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .person__name { font-family: var(--font-display); font-size: 1.2rem; font-weight: var(--fw-semibold); color: var(--navy-700); line-height: 1.25; }
  .person__role { font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.4; }
  .person__more {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-top: 8px;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
  }
  .person:hover .person__more, .person:focus-visible .person__more { opacity: 1; transform: none; }

  /* ------------------------------------------------------------ modal */
  .modal {
    border: 0;
    padding: 0;
    border-radius: var(--r-xl);
    max-width: 620px;
    width: calc(100% - var(--sp-8));
    max-height: min(88vh, 780px);
    box-shadow: var(--shadow-lg);
    background: var(--surface-card);
    overflow: hidden;
  }
  .modal::backdrop { background: rgba(13, 41, 66, 0.6); backdrop-filter: blur(3px); }

  .modal__inner {
    max-height: min(88vh, 780px);
    overflow-y: auto;
    position: relative;
  }

  .modal__close {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 0;
    background: rgba(13, 41, 66, 0.55);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .modal__close:hover { background: rgba(13, 41, 66, 0.75); }

  .modal__photo {
    width: 100%;
    /* photoHero images are portrait headshots at widths from ~380–720px —
       far narrower than the ~600px this box renders at. object-fit:cover
       has to upscale to fill the width, and the narrowest photos (e.g.
       Christine at 383px) only had ~44–47% of their height still visible
       after that at a 4/3 (or wider) box — an extreme, chin-to-hairline
       crop. Square shows 60–95% of each source (worked through the actual
       numbers per photo, narrowest to widest) without cropping anyone's
       face — the trade is a taller photo block than a typical wide modal
       header, which is why .modal__inner scrolls. */
    aspect-ratio: 1 / 1;
    background: var(--sky-100);
    overflow: hidden;
  }
  .modal__photo img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }

  .modal__body { padding: clamp(var(--sp-6), 4vw, var(--sp-10)); }
  .modal__body h2 { margin: 0 0 4px; font-size: 1.9rem; }
  .modal__role { margin: 0 0 var(--sp-6); color: var(--accent-primary); font-weight: var(--fw-bold); font-size: var(--fs-sm); letter-spacing: 0.02em; text-transform: uppercase; }

  .modal__quote {
    margin: 0 0 var(--sp-6);
    padding: var(--sp-5) var(--sp-6);
    background: var(--sky-100);
    border-radius: var(--r-md);
  }
  .modal__quote-label {
    margin: 0 0 6px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--sky-600);
  }
  .modal__quote p:last-child {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--navy-700);
  }

  /* .modal__bio and .modal__facts' children are injected via innerHTML at
     runtime (see the <script> below) — Astro can only scope elements it
     rendered itself, so plain selectors here silently match nothing. Every
     rule reaching into that dynamic content has to go through :global(). */
  :global(.modal__bio p) { margin: 0; color: var(--text-body); line-height: var(--lh-body); }

  /* Small tinted tiles, same caption-over-value language as .modal__quote
     above it (sky-100 fill, sky-600 caps label) so the two blocks read as
     one family instead of a quote box sitting over a bare data list. */
  .modal__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
    margin: var(--sp-6) 0 0;
    padding: 0;
  }
  :global(.modal__facts div) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--sp-4);
    background: var(--sky-100);
    border-radius: var(--r-md);
  }
  :global(.modal__facts dt) {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--sky-600);
  }
  :global(.modal__facts dd) { margin: 0; font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--navy-700); line-height: 1.4; }

  @media (max-width: 620px) {
    .people { grid-template-columns: repeat(2, 1fr); }
    .person__photo { width: 104px; height: 104px; }
    .modal__facts { grid-template-columns: 1fr; }
  }
</style>
