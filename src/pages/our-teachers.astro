---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import ExploreLinks from '../components/sections/ExploreLinks.astro';
import OrgCard from '../components/OrgCard.astro';
import { teachers, type Teacher } from '../data/teachers';
import { img } from '../lib/images';
import { cam } from '../data/accreditation';

const byId = (id: string) => teachers.find((t) => t.id === id)!;
const principal = byId('cedric');
const head = byId('ian-foster');

/** Second row of the chart, left to right. The Head Teacher's branch splits
    into class teachers and specialists; the other two leads carry whoever
    reports to them via `reportsTo`. */
type Branch = { lead: Teacher; groups: { label?: string; people: Teacher[] }[] };
const branches: Branch[] = [
  {
    lead: head,
    groups: [
      { label: 'Early Years & Homeroom', people: teachers.filter((t) => t.department === 'Primary') },
      { label: 'Specialists', people: teachers.filter((t) => t.department === 'Specialist') },
    ],
  },
  ...['kwanchanok', 'chanya'].map((id) => {
    const reports = teachers.filter((t) => t.reportsTo === id);
    return { lead: byId(id), groups: reports.length ? [{ people: reports }] : [] };
  }),
];

/** Only what the modal reads — the grid renders the rest from the server.
    Staff without a written bio have no profile to open, so they're left out
    here and rendered as a plain card below. */
const profiles = teachers
  .filter((t) => t.bio)
  .map(({ id, name, role, photoHero, bio, quote, quoteLabel, facts }) => ({
  id,
  name,
  role,
  photoHero: img(photoHero ?? '')?.src ?? photoHero,
  bio,
  quote,
  quoteLabel,
  facts,
}));

const hasProfile = new Set(profiles.map((p) => p.id));
---

<BaseLayout
  title="Our Teachers & Leadership Team"
  description="Meet the people your child spends the day with — the ISPG founding team of international leadership, primary teachers and specialists on Koh Phangan."
  image="/media/teachers/team-hero.webp"
>
  <PageHero
    eyebrow="Our founding team"
    title="The people your child will <em>spend their days with</em>"
    lead="Small classes mean every teacher knows every child — not as a name on a register, but as a person with a particular way of getting stuck and a particular way of getting unstuck. Where a full profile is written, click the card to read it."
    image="/media/teachers/team-hero.webp"
  />

  {/* ------------------------------------------------------- org chart */}
  <section class="section">
    <div class="container">
      <div class="org" data-org>
        <div class="org__root">
          <OrgCard person={principal} clickable={hasProfile.has(principal.id)} size="lg" eager />
        </div>
        <span class="org__stem org__stem--root" style="--d:250ms" aria-hidden="true"></span>

        <div class="org__branches">
          {branches.map((b, bi) => (
            <div class:list={['org__branch', `org__branch--${b.lead.id}`]}>
              <span class="org__bar" style="--d:450ms" aria-hidden="true"></span>
              <span class="org__drop" style="--d:650ms" aria-hidden="true"></span>
              <OrgCard person={b.lead} clickable={hasProfile.has(b.lead.id)} size="md" eager delay={750 + bi * 140} />

              {b.groups.length > 0 && (
                <>
                  <span class="org__stem" style={`--d:${1100 + bi * 140}ms`} aria-hidden="true"></span>
                  <div class:list={['org__groups', b.groups.length > 1 && 'org__groups--split']}>
                    {b.groups.map((g, gi) => (
                      <div class="org__group">
                        {b.groups.length > 1 && <span class="org__bar" style={`--d:${1250 + bi * 140}ms`} aria-hidden="true"></span>}
                        {g.label && <p class="org__label" style={`--d:${1350 + gi * 100}ms`}>{g.label}</p>}
                        <ul class="org__list" style={`--d:${1350 + bi * 140}ms`}>
                          {g.people.map((t, i) => (
                            <li>
                              <OrgCard person={t} clickable={hasProfile.has(t.id)} delay={1450 + bi * 140 + gi * 90 + i * 70} />
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Modal shell — populated from the button that opened it. */}
  <dialog class="modal" data-modal aria-labelledby="modal-name">
    <div class="modal__inner">
      <button class="modal__close" type="button" data-modal-close aria-label="Close">&times;</button>

      <div class="modal__photo">
        <img data-modal-photo alt="" decoding="async" />
      </div>

      <div class="modal__body">
        <h2 id="modal-name" data-modal-name></h2>
        <p class="modal__role" data-modal-role></p>

        <blockquote class="modal__quote" data-modal-quote hidden>
          <p class="modal__quote-label" data-modal-quote-label></p>
          <p data-modal-quote-text></p>
        </blockquote>

        <div class="modal__bio" data-modal-bio></div>

        <dl class="modal__facts" data-modal-facts></dl>
      </div>
    </div>
  </dialog>

  <ExploreLinks
    alt
    eyebrow="More about the school"
    title="Where they <em>teach</em>"
    items={[
      { title: 'Our story & campus', body: 'How ISPG began, and the site it grew on.', href: '/about/' },
      { title: 'Our FLAIR approach', body: 'The five commitments every teacher plans against.', href: '/flair/' },
      { title: 'Academics', body: `${cam('The Cambridge pathway', 'The academic pathway')} they deliver, from age 2 to 11.`, href: '/academics/' },
      { title: 'How to apply', body: 'Six steps to joining their classrooms.', href: '/admission/' },
    ]}
  />

  <CtaBand
    eyebrow="Meet us"
    title="Come and meet the <em>team</em>"
    lead="A tour includes time with the teachers for your child’s stage — not just the admissions office."
  />
</BaseLayout>

<script define:vars={{ profiles }}>
  // Draw the chart once it scrolls into view (lines first, then people).
  const org = document.querySelector('[data-org]');
  if (org) {
    if (!('IntersectionObserver' in window)) org.classList.add('is-in');
    else {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          org.classList.add('is-in');
          io.disconnect();
        }
      }, { threshold: 0.08 });
      io.observe(org);
    }
  }

  const modal = document.querySelector('[data-modal]');
  const byId = Object.fromEntries(profiles.map((t) => [t.id, t]));
  let lastFocused = null;

  document.querySelectorAll('[data-person]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const t = byId[btn.dataset.person];
      if (!t || !modal) return;
      lastFocused = btn;

      const photo = modal.querySelector('[data-modal-photo]');
      photo.src = t.photoHero;
      photo.alt = `${t.name}, ${t.role} at ISPG`;

      modal.querySelector('[data-modal-name]').textContent = t.name;
      modal.querySelector('[data-modal-role]').textContent = t.role;
      modal.querySelector('[data-modal-bio]').innerHTML = `<p>${t.bio}</p>`;

      const q = modal.querySelector('[data-modal-quote]');
      q.hidden = !t.quote;
      if (t.quote) {
        modal.querySelector('[data-modal-quote-label]').textContent = t.quoteLabel ?? '';
        modal.querySelector('[data-modal-quote-text]').textContent = `“${t.quote}”`;
      }

      const facts = modal.querySelector('[data-modal-facts]');
      facts.innerHTML = (t.facts ?? [])
        .map((f) => `<div><dt>${f.label}</dt><dd>${f.value}</dd></div>`)
        .join('');

      modal.showModal();
      modal.querySelector('.modal__inner').scrollTop = 0;
    });
  });

  const closeModal = () => {
    modal?.close();
    lastFocused?.focus();
  };

  modal?.querySelector('[data-modal-close]')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  modal?.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeModal();
  });
</script>

<style>
  /* ------------------------------------------------------- org chart
     Connectors are plain spans that scale in from their origin once the
     chart gets .is-in; --d staggers each piece so the tree "grows" from
     the principal down. */
  .org { --line: var(--sky-400, #8cc8f0); --gap: 36px; display: flex; flex-direction: column; align-items: center; }
  .org__root { display: flex; justify-content: center; }

  .org__stem, .org__drop, .org__bar { display: block; background: var(--line); border-radius: 2px; }
  .org__stem, .org__drop { width: 3px; height: var(--gap); margin: 0 auto; transform-origin: top; }
  .org__bar { position: absolute; top: 0; height: 3px; transform-origin: center; }

  .org__branches {
    width: 100%;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 0 var(--sp-6);
  }
  .org__branch { position: relative; display: flex; flex-direction: column; align-items: center; }
  
  /* Bar across the top of the row: from each lead's centre to the gutter. */
  .org__branch > .org__bar { left: calc(var(--sp-6) / -2); right: calc(var(--sp-6) / -2); }
  .org__branch:first-child > .org__bar { left: 50%; }
  .org__branch:last-child > .org__bar { right: 50%; }

  .org__groups { width: 100%; display: grid; gap: 0 var(--sp-5); }
  .org__groups--split { grid-template-columns: 1fr 1fr; }
  .org__group { position: relative; padding-top: var(--gap); }
  .org__groups:not(.org__groups--split) .org__group { padding-top: 0; }
  .org__groups--split .org__group > .org__bar { left: calc(var(--sp-5) / -2); right: calc(var(--sp-5) / -2); }
  .org__groups--split .org__group:first-child > .org__bar { left: 0; }
  .org__groups--split .org__group:last-child > .org__bar { right: calc(100% - 3px); }
  /* Short drop from the split bar into each column. */
  .org__groups--split .org__group::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: var(--gap);
    background: var(--line);
    transform-origin: top;
  }

  .org__label {
    position: relative;
    margin: 0;
    padding: var(--sp-3) 0 var(--sp-3) 22px;
    height: 60px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--sky-600);
  }

  /* A rail runs down the list and every card hangs off it. Each <li>
     draws its own piece of rail (to its centre on the last card) so the
     line always ends exactly where the last tick does. */
  .org__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 22px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .org__list li { position: relative; }
  .org__groups:not(.org__groups--split) .org__list { align-items: center; }
  .org__list li::before, .org__list li::after {
    content: '';
    position: absolute;
    left: -22px;
    background: var(--line);
  }
  .org__list li::before { top: calc(50% - 1.5px); width: 22px; height: 3px; }
  .org__list li::after { top: calc(-1 * var(--sp-3)); bottom: 0; width: 3px; }
  .org__list li:last-child::after { bottom: calc(50% - 1.5px); }
  /* First rail piece reaches up into the label/drop above it. */
  .org__list li:first-child::after { top: -60px; }
  .org__groups:not(.org__groups--split) .org__list li:first-child::after { top: 0; }

  /* A lone report sits straight under its lead — no rail needed. */
  .org__groups:not(.org__groups--split) .org__list { padding-left: 0; }
  .org__groups:not(.org__groups--split) .org__list li::before,
  .org__groups:not(.org__groups--split) .org__list li::after { display: none; }

  /* Entrance animation. A light pulse keeps running along the lines after. */
  :global(.js) .org__stem, :global(.js) .org__drop { transform: scaleY(0); }
  :global(.js) .org__bar { transform: scaleX(0); }
  :global(.js) .org__groups--split .org__group::before { transform: scaleY(0); }
  :global(.js) .org__list li::before, :global(.js) .org__list li::after { opacity: 0; }
  :global(.js) .org__label { opacity: 0; }
  .org.is-in .org__stem, .org.is-in .org__drop, .org.is-in .org__bar,
  .org.is-in .org__label {
    transform: none;
    opacity: 1;
    transition: transform 450ms var(--ease-out) var(--d), opacity 400ms var(--ease-out) var(--d);
  }
  .org.is-in .org__list li::before, .org.is-in .org__list li::after { opacity: 1; transition: opacity 500ms var(--ease-out) var(--d); }
  .org.is-in .org__groups--split .org__group::before { transform: none; transition: transform 300ms var(--ease-out) 1300ms; }

  .org.is-in .org__stem, .org.is-in .org__drop {
    background: linear-gradient(180deg, var(--line) 0%, var(--line) 40%, #fff 50%, var(--line) 60%, var(--line) 100%) 0 0 / 100% 300%;
    animation: org-flow 3.5s linear 2.4s infinite;
  }
  @keyframes org-flow { from { background-position: 0 100%; } to { background-position: 0 -200%; } }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .org__stem, :global(.js) .org__drop, :global(.js) .org__bar,
    :global(.js) .org__groups--split .org__group::before { transform: none; }
    :global(.js) .org__list li::before, :global(.js) .org__list li::after { opacity: 1; }
    :global(.js) .org__label { opacity: 1; }
    .org.is-in .org__stem, .org.is-in .org__drop { animation: none; }
  }

  /* Narrow screens: one column, every branch stacked under the principal. */
  @media (max-width: 960px) {
    .org__branches { grid-template-columns: 1fr; gap: var(--sp-8); max-width: 520px; }
    .org__branch > .org__bar { display: none; }
    .org__root, .org__root :global(.org-card), .org__branch > :global(.org-card), .org__list :global(.org-card) { width: 100%; }
    .org__groups:not(.org__groups--split) .org__list { align-items: stretch; }
    .org__branch:not(:first-child) > .org__drop { display: none; }
    .org__groups--split { grid-template-columns: 1fr; }
    .org__groups--split .org__group > .org__bar,
    .org__groups--split .org__group::before { display: none; }
    .org__groups--split .org__group { padding-top: 0; }
  }

  /* ------------------------------------------------------------ modal */
  .modal {
    border: 0;
    padding: 0;
    border-radius: var(--r-xl);
    max-width: 620px;
    width: calc(100% - var(--sp-8));
    max-height: min(88vh, 780px);
    box-shadow: var(--shadow-lg);
    background: var(--surface-card);
    overflow: hidden;
  }
  .modal::backdrop { background: rgba(13, 41, 66, 0.6); backdrop-filter: blur(3px); }

  .modal__inner {
    max-height: min(88vh, 780px);
    overflow-y: auto;
    position: relative;
  }

  .modal__close {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 0;
    background: rgba(13, 41, 66, 0.55);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .modal__close:hover { background: rgba(13, 41, 66, 0.75); }

  .modal__photo {
    width: 100%;
    /* photoHero images are portrait headshots at widths from ~380–720px —
       far narrower than the ~600px this box renders at. object-fit:cover
       has to upscale to fill the width, and the narrowest photos (e.g.
       Christine at 383px) only had ~44–47% of their height still visible
       after that at a 4/3 (or wider) box — an extreme, chin-to-hairline
       crop. Square shows 60–95% of each source (worked through the actual
       numbers per photo, narrowest to widest) without cropping anyone's
       face — the trade is a taller photo block than a typical wide modal
       header, which is why .modal__inner scrolls. */
    aspect-ratio: 1 / 1;
    background: var(--sky-100);
    overflow: hidden;
  }
  .modal__photo img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }

  .modal__body { padding: clamp(var(--sp-6), 4vw, var(--sp-10)); }
  .modal__body h2 { margin: 0 0 4px; font-size: 1.9rem; }
  .modal__role { margin: 0 0 var(--sp-6); color: var(--accent-primary); font-weight: var(--fw-bold); font-size: var(--fs-sm); letter-spacing: 0.02em; text-transform: uppercase; }

  .modal__quote {
    margin: 0 0 var(--sp-6);
    padding: var(--sp-5) var(--sp-6);
    background: var(--sky-100);
    border-radius: var(--r-md);
  }
  .modal__quote-label {
    margin: 0 0 6px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--sky-600);
  }
  .modal__quote p:last-child {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--navy-700);
  }

  /* .modal__bio and .modal__facts' children are injected via innerHTML at
     runtime (see the <script> below) — Astro can only scope elements it
     rendered itself, so plain selectors here silently match nothing. Every
     rule reaching into that dynamic content has to go through :global(). */
  :global(.modal__bio p) { margin: 0; color: var(--text-body); line-height: var(--lh-body); }

  /* Small tinted tiles, same caption-over-value language as .modal__quote
     above it (sky-100 fill, sky-600 caps label) so the two blocks read as
     one family instead of a quote box sitting over a bare data list. */
  .modal__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
    margin: var(--sp-6) 0 0;
    padding: 0;
  }
  :global(.modal__facts div) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--sp-4);
    background: var(--sky-100);
    border-radius: var(--r-md);
  }
  :global(.modal__facts dt) {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--sky-600);
  }
  :global(.modal__facts dd) { margin: 0; font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--navy-700); line-height: 1.4; }

  @media (max-width: 620px) {
    .modal__facts { grid-template-columns: 1fr; }
  }
</style>
