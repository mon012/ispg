---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Badge from '../components/ui/Badge.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { articles, topics, excerpt } from '../lib/content';

const fmt = (d?: string | null) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

const [lead, ...rest] = articles;
---

<BaseLayout
  title="News & Blog"
  description="Montessori, parenting in the age of AI, screen time and island life — writing from ISPG, the International School of Phangan, plus news from campus."
  image={articles[0]?.hero ?? undefined}
>
  <PageHero
    eyebrow="News & Events"
    title="From <em>campus</em>, and from the research"
    lead="What is happening at school, and what the evidence says about how children actually learn."
    size="sm"
    image="/media/site/presentation.webp"
  />

  {/* Client-side topic filter — no separate category routes. */}
  <section class="section tight">
    <div class="container">
      <div class="filters" role="group" aria-label="Filter articles by topic">
        <button class="chip is-active" type="button" data-topic="all">All</button>
        {topics.map((t) => <button class="chip" type="button" data-topic={t}>{t}</button>)}
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ lead */}
  {lead && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <a class="feature" href={`/${lead.slug}/`} data-article data-topic={lead.topic ?? ''}>
          {lead.hero && <img class="feature__img" src={lead.hero} alt={lead.title} loading="eager" decoding="async" />}
          <div class="feature__body">
            <div class="feature__meta">
              {lead.topic && <Badge tone="gold">{lead.topic}</Badge>}
              {lead.published && <time datetime={lead.published}>{fmt(lead.published)}</time>}
            </div>
            <h2 class="feature__title">{lead.title}</h2>
            <p class="feature__excerpt">{excerpt(lead.html, 220)}</p>
            <span class="feature__more">Read the article</span>
          </div>
        </a>
      </div>
    </section>
  )}

  {/* ----------------------------------------------------------- grid */}
  <section class="section" style="padding-top:0">
    <div class="container">
      <ul class="posts" data-posts>
        {rest.map((a, i) => (
          <li data-article data-topic={a.topic ?? ''} data-reveal data-reveal-delay={Math.min(i, 5) * 70}>
            <a href={`/${a.slug}/`}>
              {a.hero && <img src={a.hero} alt={a.title} loading="lazy" decoding="async" />}
              <div class="posts__body">
                <div class="posts__meta">
                  {a.topic && <Badge tone="gold">{a.topic}</Badge>}
                  {a.published && <time datetime={a.published}>{fmt(a.published)}</time>}
                </div>
                <h2>{a.title}</h2>
                <p>{excerpt(a.html, 130)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="empty" data-empty hidden>No articles in that topic yet.</p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-topic][type="button"]');
  const items = document.querySelectorAll<HTMLElement>('[data-article]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const topic = chip.dataset.topic;
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));

      let shown = 0;
      items.forEach((item) => {
        const match = topic === 'all' || item.dataset.topic === topic;
        // The lead article is a link, the rest are list items — hide the element itself.
        item.hidden = !match;
        if (match) shown += 1;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>

<style>
  .filters { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    padding: 9px 18px;
    border-radius: var(--r-pill);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--navy-700);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .chip:hover { background: var(--sky-100); border-color: var(--sky-400); }
  .chip.is-active { background: var(--navy-700); border-color: var(--navy-700); color: #fff; }

  /* ------------------------------------------------------------ lead */
  .feature {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: box-shadow var(--dur-base) var(--ease-standard);
  }
  .feature:hover { box-shadow: var(--shadow-lg); }
  .feature[hidden] { display: none; }
  .feature__img { width: 100%; height: 100%; min-height: 320px; object-fit: cover; display: block; }
  .feature__body {
    padding: clamp(var(--sp-6), 4vw, var(--sp-12));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
    justify-content: center;
  }
  .feature__meta, .posts__meta { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
  .feature__meta time, .posts__meta time { font-size: var(--fs-xs); color: var(--text-caption); letter-spacing: 0.04em; }
  .feature__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    color: var(--navy-700);
  }
  .feature__excerpt { margin: 0; color: var(--text-muted); line-height: var(--lh-body); }
  .feature__more {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: 0.02em;
    color: var(--accent-primary);
  }

  /* ------------------------------------------------------------ grid */
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--sp-6), 3vw, var(--sp-8));
  }
  .posts li[hidden] { display: none; }
  .posts a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: box-shadow var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
  }
  .posts a:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .posts img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .posts__body { padding: var(--sp-6); display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-3); }
  .posts__body h2 { margin: 0; font-size: 1.3rem; line-height: 1.25; color: var(--navy-700); font-weight: var(--fw-semibold); }
  .posts__body p { margin: 0; font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.6; }

  .empty { margin: var(--sp-10) 0 0; text-align: center; color: var(--text-muted); }

  @media (max-width: 1000px) { .posts { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 800px) {
    .feature { grid-template-columns: 1fr; }
    .feature__img { min-height: 0; aspect-ratio: 16 / 9; }
  }
  @media (max-width: 560px) { .posts { grid-template-columns: 1fr; } }
</style>
