---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import GumletVideo from '../components/sections/GumletVideo.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/site/Icon.astro';
import { embeds } from '../data/site';
import { pillars } from '../data/flair';

const explore = [
  { title: 'Our FLAIR Approach', body: 'The five commitments behind every decision we make.', href: '/flair/' },
  { title: 'Academics', body: 'One connected pathway from Nursery to Key Stage 2.', href: '/academics/' },
  { title: 'School Life', body: 'The campus, the pool, the food and the days in between.', href: '/school-life/' },
  { title: 'Our Teachers', body: 'The people your child will spend their days with.', href: '/our-teachers/' },
];
---

<BaseLayout
  title="About Us: Our Story & Campus on Koh Phangan"
  description="How a Cambridge Curriculum international school took shape on Koh Phangan — the campus, the people behind it, and what the FLAIR philosophy looks like in an ordinary school day."
  image="/media/site/pupils-group.webp"
>
  <PageHero
    eyebrow="About us"
    title="A school built around the <em>whole child</em>"
    lead="Cambridge rigour, Montessori foundations and an island that teaches as much as any classroom."
    image="/media/site/pupils-group.webp"
  />

  {/* ---------------------------------------------------------- opening */}
  <section class="section">
    <div class="container narrow" data-reveal>
      <p class="opening">
        The International School of Phangan is a Cambridge Curriculum school that develops
        the whole child. We guide families through every stage of learning, from Montessori
        foundations to the Cambridge Curriculum.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- film */}
  <section class="section tight" id="film">
    <div class="container film">
      <div class="film__head" data-reveal>
        <SectionHeading
          align="center"
          size="sm"
          eyebrow="Our film"
          title="See the school <em>for yourself</em>"
        />
      </div>
      <div data-reveal data-reveal-delay="100">
        <GumletVideo id={embeds.schoolFilm} title="ISPG school film" />
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------- where we are */}
  <section class="section alt">
    <div class="container">
      <div class="where">
        <div class="where__media" data-reveal>
          <Image
            src={img('/media/site/campus-aerial.webp')!}
            alt="The ISPG campus on Koh Phangan"
            widths={[560, 1120]}
            sizes="(min-width: 900px) 560px, 100vw"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="where__body" data-reveal data-reveal-delay="90">
          <SectionHeading
            size="sm"
            eyebrow="Where we are"
            title="An island that is part of the <em>curriculum</em>"
          />
          <p>
            Our campus sits at Ban Tai on Koh Phangan, a few minutes from the water. That
            proximity is not incidental. Children learn about ecosystems by standing in them,
            and swim in a professional 25-metre pool every week. They grow up treating the
            island as their responsibility.
          </p>
          <p>
            It also shapes who we are as a community. Our families come from across the world,
            and many stay for years. The school stays small enough that every child is known
            by name — and international enough that no child is the only one from somewhere else.
          </p>
          <Button variant="secondary" href="/school-life/">
            Explore school life
            <Icon name="arrow-right" size={15} slot="icon-right" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ FLAIR */}
  <section class="section navy">
    <div class="container">
      <div data-reveal>
        <SectionHeading
          align="center"
          tone="dark"
          size="md"
          eyebrow="Our philosophy"
          eyebrowColor="var(--sky-300)"
          title="Everything we do begins with <em>FLAIR</em>"
          lead="Future Leadership, Lifelong Learning, Active Living, an International Mindset, and being Rooted in Nature."
        />
      </div>
      <ul class="pillars">
        {pillars.map((p, i) => (
          <li data-reveal data-reveal-delay={i * 80}>
            <span class="pillars__letter" style={`background:${p.accent}`} aria-hidden="true">{p.letter}</span>
            <span class="pillars__name">{p.name}</span>
            <span class="pillars__body">{p.short}</span>
          </li>
        ))}
      </ul>
      <div class="pillars__cta" data-reveal>
        <Button variant="onNavy" href="/flair/">
          Read the full approach
          <Icon name="arrow-right" size={15} slot="icon-right" />
        </Button>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- explore */}
  <section class="section">
    <div class="container">
      <div data-reveal>
        <SectionHeading size="sm" eyebrow="Keep looking" title="Explore <em>further</em>" />
      </div>
      <ul class="explore">
        {explore.map((e, i) => (
          <li data-reveal data-reveal-delay={i * 80}>
            <a href={e.href}>
              <span class="explore__title">{e.title}</span>
              <span class="explore__body">{e.body}</span>
              <Icon name="arrow-right" size={18} class="explore__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .opening {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.42;
    color: var(--navy-700);
    text-align: center;
  }

  .film { max-width: 980px; }
  .film__head { margin-bottom: var(--sp-8); }

  .where { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(var(--sp-8), 5vw, var(--sp-16)); align-items: center; }
  .where__media { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-md); }
  .where__media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .where__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-5); }
  .where__body p { margin: 0; color: var(--text-muted); line-height: var(--lh-body); }

  .pillars {
    list-style: none;
    margin: var(--sp-12) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-5);
  }
  .pillars li { display: flex; flex-direction: column; gap: 10px; }
  .pillars__letter {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 22px;
  }
  .pillars__name { font-family: var(--font-display); font-size: 1.1rem; color: #fff; font-weight: var(--fw-semibold); line-height: 1.2; }
  .pillars__body { color: var(--text-on-navy-muted); font-size: 14px; line-height: 1.5; }
  .pillars__cta { margin-top: var(--sp-16); display: flex; justify-content: center; }

  .explore { list-style: none; margin: var(--sp-8) 0 0; padding: 0; display: grid; gap: 0; }
  .explore li { border-top: 1px solid var(--border-hairline); }
  .explore li:last-child { border-bottom: 1px solid var(--border-hairline); }
  .explore a {
    display: grid;
    grid-template-columns: minmax(0, 260px) 1fr auto;
    align-items: center;
    gap: var(--sp-6);
    padding: var(--sp-6) var(--sp-2);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard), padding-inline var(--dur-base) var(--ease-standard);
  }
  .explore a:hover { background: var(--paper-2); padding-inline: var(--sp-5); }
  .explore__title { font-family: var(--font-display); font-size: 1.5rem; color: var(--navy-700); font-weight: var(--fw-semibold); }
  .explore__body { color: var(--text-muted); font-size: var(--fs-sm); }
  .explore__arrow { color: var(--accent-primary); }

  @media (max-width: 1000px) { .pillars { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) {
    .where { grid-template-columns: 1fr; }
    .explore a { grid-template-columns: 1fr auto; }
    .explore__body { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) { .pillars { grid-template-columns: 1fr; } }
</style>
