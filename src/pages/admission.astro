---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/site/Icon.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import GumletVideo from '../components/sections/GumletVideo.astro';
import { steps, nextSteps } from '../data/admission';
import { embeds } from '../data/site';
import { admissionFaq } from '../data/faq';
import { faqSchema } from '../lib/seo';
---

<BaseLayout
  title="Admissions: How to Apply in Six Steps"
  description="How to enrol at ISPG on Koh Phangan: enquiry and campus visit, online application, THB 3,000 application fee, a trial day, written confirmation and your child's start date. Ages 2 to 11, mid-year entry welcome."
  image="/media/site/admissions-desk.webp"
  schema={faqSchema(admissionFaq)}
>
  <PageHero
    eyebrow="Admission"
    title="Six steps, and we walk <em>all of them</em> with you"
    lead="Starting at ISPG is simple and welcoming. We support families throughout the process to make sure it is the right fit for your child."
    image="/media/site/admissions-desk.webp"
  />

  {/* ------------------------------------------------------------ steps */}
  <section class="section">
    <div class="container">
      <div class="steps__head" data-reveal>
        <SectionHeading size="sm" eyebrow="The process" title="How admission <em>works</em>" />
      </div>

      <div class="steps__wrap" data-steps>
        <div class="steps__rail" aria-hidden="true">
          <div class="steps__rail-fill"></div>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="step" data-reveal data-reveal-delay={i * 70}>
              <span class="step__n" aria-hidden="true">{String(s.n).padStart(2, '0')}</span>
              <div class="step__body">
                <h3 class="step__title">{s.title}</h3>
                <p class="step__copy">{s.body}</p>
                {s.action && (
                  <a class="step__link" href={s.action.href}>
                    {s.action.label}
                    <Icon name="arrow-right" size={15} />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ what's next */}
  <section class="section alt">
    <div class="container">
      <div data-reveal>
        <SectionHeading size="sm" eyebrow="Everything else" title="What you need <em>next</em>" />
      </div>
      <ul class="next">
        {nextSteps.map((n, i) => (
          <li data-reveal data-reveal-delay={i * 80}>
            <a
              href={n.href}
              target={n.external ? '_blank' : undefined}
              rel={n.external ? 'noopener noreferrer' : undefined}
            >
              <span class="next__title">
                {n.title}
                {n.external && <Icon name="external-link" size={14} />}
              </span>
              <span class="next__body">{n.body}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------------- film
       Reuses the Open House event footage — filmed for that campaign, but it
       is real ISPG activity (Montessori stations, swimming, climbing), which
       is exactly what an admitting parent wants to see mid-way through the
       steps, before the closing reassurance/CTA. */}
  <section class="section tight">
    <div class="container film">
      <div class="film__head" data-reveal>
        <SectionHeading align="center" size="sm" eyebrow="See it for yourself" title="What a morning at ISPG <em>looks like</em>" />
      </div>
      <div data-reveal data-reveal-delay="100">
        <GumletVideo id={embeds.openHouseFilm} title="A morning at ISPG" />
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- reassure */}
  <section class="section">
    <div class="container narrow reassure" data-reveal>
      <h2>Not sure where your child fits?</h2>
      <p>
        Children join us mid-year as well as at the start of one, and stage placement is based
        on readiness rather than birthday alone. If you are unsure which year group applies,
        send us your child’s age and current school year and we will tell you exactly where
        they would start.
      </p>
      <div class="reassure__actions">
        <Button variant="primary" href="/contact/">Ask our admissions team</Button>
        <Button variant="secondary" href="/fees/">See the fee schedule</Button>
      </div>
    </div>
  </section>

  <FaqSection items={admissionFaq} alt title="Admission questions families <em>ask us</em>" />

  <CtaBand />
</BaseLayout>

<style>
  .steps__head { margin-bottom: var(--sp-12); }

  .film { max-width: 960px; }
  .film__head { margin-bottom: var(--sp-8); }

  /* ---------------------------------------------------------------- rail
     A dotted line in the gutter beside the step numbers (not through their
     strokes — it used to bisect the glyphs, which read as a rendering
     glitch rather than a deliberate line) whose fill height tracks scroll
     position directly (not a one-shot reveal) — it grows and shrinks as you
     scroll past the section in either direction, and each number lights up
     in its own colour the moment the line reaches it. Height (not
     transform: scaleY) so the dash pattern itself never stretches. A small
     glowing node rides the tip of the fill as a leading marker, so the line
     reads as something actively travelling rather than a static bar filling
     in. */
  .steps__wrap { position: relative; }
  .steps__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(120px + clamp(var(--sp-5), 4vw, var(--sp-12)) / 2 - 1.5px);
    width: 3px;
    background: repeating-linear-gradient(to bottom, var(--border-hairline) 0 3px, transparent 3px 13px);
  }
  .steps__rail-fill {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: calc(var(--progress, 0) * 100%);
    background: repeating-linear-gradient(to bottom, var(--accent-primary) 0 3px, transparent 3px 13px);
    transition: height 120ms linear;
  }
  .steps__rail-fill::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent-primary);
    transform: translate(-50%, 50%);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent-primary) 16%, transparent);
    opacity: var(--progress, 0);
    transition: opacity 200ms var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .steps__rail-fill { transition: none; }
  }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; counter-reset: step; }

  .step {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: clamp(var(--sp-5), 4vw, var(--sp-12));
    padding: clamp(var(--sp-6), 3vw, var(--sp-10)) 0;
    border-top: 1px solid var(--border-hairline);
    position: relative;
  }
  .step:last-child { border-bottom: 1px solid var(--border-hairline); }

  .step__n {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 0.85;
    color: var(--line-300);
    transition: color 400ms var(--ease-out);
  }
  .step.is-lit:nth-child(1) .step__n { color: var(--sky-300); }
  .step.is-lit:nth-child(2) .step__n { color: var(--sky-400); }
  .step.is-lit:nth-child(3) .step__n { color: var(--gold-400); }
  .step.is-lit:nth-child(4) .step__n { color: var(--orange-400); }
  .step.is-lit:nth-child(5) .step__n { color: var(--coral-400); }
  .step.is-lit:nth-child(6) .step__n { color: var(--coral-500); }
  @media (prefers-reduced-motion: reduce) {
    .step__n { transition: none; }
  }

  .step__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-3); max-width: 62ch; }
  .step__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--navy-700);
  }
  .step__copy { margin: 0; color: var(--text-muted); line-height: var(--lh-body); }
  .step__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: 0.02em;
    color: var(--accent-primary);
    text-decoration: none;
  }
  .step__link:hover { gap: 11px; }
  .step__link { transition: gap var(--dur-fast) var(--ease-standard); }

  .next {
    list-style: none;
    margin: var(--sp-10) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-5);
  }
  .next a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: var(--sp-6);
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: box-shadow var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
  }
  .next a:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .next__title {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: var(--fw-semibold);
    color: var(--navy-700);
  }
  .next__body { font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.5; }

  .reassure { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--sp-5); }
  .reassure h2 { margin: 0; font-size: var(--fs-display-3); font-weight: var(--fw-medium); }
  .reassure p { margin: 0; color: var(--text-muted); line-height: var(--lh-body); }
  .reassure__actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; justify-content: center; }

  @media (max-width: 1000px) { .next { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) {
    /* Numbers stack above their body copy here, so a rail tuned to the
       120px desktop number column has nothing left to thread through. */
    .steps__rail { display: none; }
    .step { grid-template-columns: 1fr; gap: var(--sp-3); }
    .step__n { font-size: 2.5rem; color: var(--sky-300); }
    .step:nth-child(2) .step__n { color: var(--sky-400); }
    .step:nth-child(3) .step__n { color: var(--gold-400); }
    .step:nth-child(4) .step__n { color: var(--orange-400); }
    .step:nth-child(5) .step__n { color: var(--coral-400); }
    .step:nth-child(6) .step__n { color: var(--coral-500); }
  }
  @media (max-width: 520px) { .next { grid-template-columns: 1fr; } }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-steps]');
  const stepEls = [...document.querySelectorAll<HTMLElement>('.step')];

  if (wrap && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = wrap.getBoundingClientRect();
      const vh = window.innerHeight;
      // Fill starts growing once the wrap is ~85% down the viewport and
      // finishes once its bottom has scrolled ~70% of a viewport past the
      // top — a scrub range wide enough to feel continuous while dragging
      // the scrollbar, not just on a single wheel tick.
      const start = vh * 0.85;
      const span = rect.height + vh * 0.7;
      const progress = Math.min(1, Math.max(0, (start - rect.top) / span));

      wrap.style.setProperty('--progress', String(progress));

      const n = stepEls.length;
      stepEls.forEach((el, i) => {
        const threshold = n <= 1 ? 0 : i / (n - 1);
        el.classList.toggle('is-lit', progress >= threshold);
      });
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  } else if (wrap) {
    wrap.style.setProperty('--progress', '1');
    stepEls.forEach((el) => el.classList.add('is-lit'));
  }
</script>
