---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Icon from '../components/site/Icon.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ExploreLinks from '../components/sections/ExploreLinks.astro';
import { contact } from '../data/site';
import { feesFaq } from '../data/faq';
import { faqSchema } from '../lib/seo';
import {
  academicYear,
  oneOffFees,
  tuition,
  busFees,
  learningSupport,
  siblingDiscounts,
  bankDetails,
  policyNotes,
  paymentMethods,
} from '../data/fees';

const thb = (n: number) => n.toLocaleString('en-GB');
---

<BaseLayout
  title={`School Fees ${academicYear}: Tuition, Bus & Payment Terms`}
  description={`The full ISPG fee schedule for ${academicYear} — tuition by year group, application and registration fees, school bus zones, sibling discounts and how to pay. All fees are billed in Thai Baht.`}
  schema={faqSchema(feesFaq)}
>
  <PageHero
    eyebrow={`Academic year ${academicYear}`}
    title="School <em>fees</em>"
    lead="Everything below is billed and payable in Thai Baht. Tuition includes meals, books, equipment and student group accidental insurance."
    size="sm"
    image="/media/site/meeting.webp"
  />

  {/* ------------------------------------------------------- one-off fees */}
  <section class="section">
    <div class="container">
      <div data-reveal>
        <SectionHeading size="sm" eyebrow="Before your child starts" title="One-off <em>fees</em>" />
      </div>
      <div class="grid cols-3 oneoff">
        {oneOffFees.map((f, i) => (
          <div data-reveal data-reveal-delay={i * 80}>
            <Card elevation="sm" class="oneoff__card">
              <span class="oneoff__amount">THB {thb(f.amount)}</span>
              <h3 class="oneoff__name">{f.name}</h3>
              <p class="oneoff__body">{f.body}</p>
            </Card>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- tuition */}
  <section class="section alt">
    <div class="container">
      <div data-reveal>
        <SectionHeading
          size="sm"
          eyebrow="Per year group"
          title="Tuition <em>fees</em>"
          lead="Fees are billed termly. Meals are included."
        />
      </div>

      <div class="tablewrap" data-reveal>
        <table class="fees">
          <caption class="sr-only">Tuition fees by year group and term, in Thai Baht</caption>
          <thead>
            <tr>
              <th scope="col">Year group</th>
              {tuition.columns.map((c) => <th scope="col" class="num">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {tuition.rows.map((r) => (
              <tr>
                <th scope="row">{r.group}</th>
                {r.values.map((v, i) => (
                  <td class:list={['num', i === r.values.length - 1 && 'is-total']}>{thb(v)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tablenote">All figures in THB. Fees are reviewed annually and subject to change without prior notice.</p>
    </div>
  </section>

  {/* -------------------------------------------------------------- bus */}
  <section class="section">
    <div class="container">
      <div class="two">
        <div data-reveal>
          <SectionHeading size="sm" eyebrow="Getting to school" title="School <em>bus</em>" />
          <div class="tablewrap">
            <table class="fees">
              <caption class="sr-only">School bus fees by zone and term, in Thai Baht</caption>
              <thead>
                <tr>
                  <th scope="col">Zone</th>
                  {busFees.columns.map((c) => <th scope="col" class="num">{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {busFees.rows.map((r) => (
                  <tr>
                    <th scope="row">{r.group}</th>
                    {r.values.map((v) => <td class="num">{thb(v)}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="tablenote">{busFees.zones}</p>
        </div>

        <div data-reveal data-reveal-delay="90">
          <SectionHeading size="sm" eyebrow="Extra help" title="Learning <em>support</em>" />
          <ul class="support">
            {learningSupport.map((l) => (
              <li>
                <span class="support__level">{l.level}</span>
                <span class="support__body">{l.body}</span>
                <span class="support__cost">{l.cost}</span>
              </li>
            ))}
          </ul>

          <h3 class="sub">Sibling discounts</h3>
          <ul class="siblings">
            {siblingDiscounts.map((s) => (
              <li><span>{s.group}</span><Badge tone="coral">{s.discount}</Badge></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- payment */}
  <section class="section alt">
    <div class="container">
      <div class="two">
        <div data-reveal>
          <SectionHeading size="sm" eyebrow="How to pay" title="Payment <em>methods</em>" />
          <ul class="methods">
            {paymentMethods.map((m) => (
              <li><Icon name="check" size={16} /><span>{m}</span></li>
            ))}
          </ul>
        </div>

        <div data-reveal data-reveal-delay="90">
          <Card elevation="md" class="bank">
            <h3 class="bank__title">Bank transfer details</h3>
            <dl class="bank__list">
              <div><dt>Bank</dt><dd>{bankDetails.bank}</dd></div>
              <div><dt>Account name</dt><dd>{bankDetails.accountName}</dd></div>
              <div><dt>Account number</dt><dd>{bankDetails.accountNumber}</dd></div>
              <div><dt>Account type</dt><dd>{bankDetails.accountType}</dd></div>
              <div><dt>Cheque payee</dt><dd>{bankDetails.chequePayee}</dd></div>
            </dl>
            <p class="bank__note">
              Email your payment slip with your child’s name and class to
              <a href={`mailto:${contact.email}`}>{contact.email}</a>.
            </p>
          </Card>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ notes */}
  <section class="section">
    <div class="container">
      <div data-reveal>
        <SectionHeading size="sm" eyebrow="The detail" title="Policy <em>notes</em>" />
      </div>
      <ol class="notes">
        {policyNotes.map((n, i) => (
          <li data-reveal data-reveal-delay={i * 50}>
            <h3><span class="notes__n">{i + 1}</span>{n.title}</h3>
            <ul>
              {n.points.map((p) => <li>{p}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FaqSection items={feesFaq} alt title="Fee questions families <em>ask us</em>" />

  <ExploreLinks
    eyebrow="Once the numbers make sense"
    title="What <em>happens next</em>"
    items={[
      { title: 'How to apply', body: 'The six steps from first enquiry to your child’s start date.', href: '/admission/' },
      { title: 'Academics', body: 'What the fees buy: the Cambridge pathway from age 2 to age 11.', href: '/academics/' },
      { title: 'School life', body: 'Meals, the pool and the facilities included in the school day.', href: '/school-life/' },
      { title: 'School calendar', body: 'Term dates, so you can see when payments fall.', href: '/calendar/' },
    ]}
  />

  <CtaBand
    eyebrow="Questions about fees"
    title="We will walk you through <em>the numbers</em>"
    lead="Tell us your child's age and we will send a written breakdown of exactly what the first year costs."
  />
</BaseLayout>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .oneoff { margin-top: var(--sp-10); }
  .oneoff__card { height: 100%; display: flex; flex-direction: column; gap: var(--sp-2); }
  .oneoff__amount {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: var(--fw-bold);
    color: var(--accent-primary);
    line-height: 1;
  }
  .oneoff__name { margin: var(--sp-2) 0 0; font-size: 1.25rem; }
  .oneoff__body { margin: 0; color: var(--text-muted); font-size: var(--fs-sm); line-height: 1.6; }

  /* Wide tables scroll inside their own container rather than breaking the page. */
  .tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: var(--sp-8); }
  .fees {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .fees th, .fees td { padding: var(--sp-4) var(--sp-5); text-align: left; border-bottom: 1px solid var(--border-hairline); }
  .fees thead th {
    background: var(--navy-700);
    color: #fff;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
  }
  .fees tbody th { font-family: var(--font-display); font-size: 1.15rem; color: var(--navy-700); font-weight: var(--fw-semibold); }
  .fees tbody tr:last-child th, .fees tbody tr:last-child td { border-bottom: 0; }
  .fees tbody tr:nth-child(even) { background: var(--paper); }
  .fees .num { text-align: right; font-variant-numeric: tabular-nums; }
  .is-total { font-weight: var(--fw-bold); color: var(--navy-700); }
  .tablenote { margin: var(--sp-4) 0 0; font-size: var(--fs-sm); color: var(--text-caption); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(var(--sp-10), 5vw, var(--sp-16)); align-items: start; }
  /* Grid items default to min-width:auto, which would let the 480px table
     force the column wider than the viewport. */
  .two > * { min-width: 0; }

  .support { list-style: none; margin: var(--sp-8) 0 0; padding: 0; display: grid; gap: 0; }
  .support li {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: var(--sp-4);
    align-items: baseline;
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--border-hairline);
  }
  .support li:last-child { border-bottom: 1px solid var(--border-hairline); }
  .support__level { font-weight: var(--fw-bold); color: var(--navy-700); font-size: var(--fs-sm); }
  .support__body { color: var(--text-muted); font-size: var(--fs-sm); }
  .support__cost { font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--accent-primary); white-space: nowrap; }

  .sub { margin: var(--sp-10) 0 var(--sp-4); font-size: 1.25rem; }
  .siblings { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
  .siblings li { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-4); font-size: var(--fs-sm); color: var(--text-muted); }

  .methods { list-style: none; margin: var(--sp-8) 0 0; padding: 0; display: grid; gap: var(--sp-4); }
  .methods li { display: flex; gap: var(--sp-3); align-items: flex-start; color: var(--text-muted); line-height: 1.6; font-size: var(--fs-sm); }
  .methods :global(.icon) { color: var(--sky-600); margin-top: 4px; }

  .bank__title { margin: 0 0 var(--sp-5); font-size: 1.35rem; }
  .bank__list { margin: 0; display: grid; gap: 0; }
  .bank__list div {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--border-hairline);
    flex-wrap: wrap;
  }
  .bank__list dt { font-size: var(--fs-sm); color: var(--text-caption); }
  .bank__list dd { margin: 0; font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--navy-700); text-align: right; }
  .bank__note { margin: var(--sp-5) 0 0; font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.6; }
  .bank__note a { margin-left: 4px; }

  .notes { list-style: none; margin: var(--sp-10) 0 0; padding: 0; display: grid; gap: var(--sp-10); }
  .notes > li { display: grid; grid-template-columns: minmax(0, 260px) 1fr; gap: clamp(var(--sp-5), 4vw, var(--sp-10)); }
  .notes h3 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--fw-semibold);
    color: var(--navy-700);
  }
  .notes__n {
    font-size: var(--fs-sm);
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    color: var(--accent-primary);
  }
  .notes ul { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--sp-3); }
  .notes ul li { position: relative; padding-left: 1.5em; color: var(--text-muted); line-height: 1.65; font-size: var(--fs-sm); }
  .notes ul li::before {
    content: '';
    position: absolute;
    left: 0.3em;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sky-400);
  }

  @media (max-width: 900px) {
    .two { grid-template-columns: 1fr; }
    .notes > li { grid-template-columns: 1fr; gap: var(--sp-4); }
  }
</style>
