---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import GumletVideo from '../components/sections/GumletVideo.astro';
import DeftForm from '../components/sections/DeftForm.astro';
import Icon from '../components/site/Icon.astro';
import { embeds, contact } from '../data/site';
import { pillars } from '../data/flair';
import { cam } from '../data/accreditation';

/** Campaign landing page — noindex, and deliberately outside the main nav. */
const facts = [
  { icon: 'clock' as const, label: 'Time', value: '8:30 AM – 12:00 PM' },
  { icon: 'map-pin' as const, label: 'Venue', value: 'ISPG campus, Ban Tai, Koh Phangan' },
  { icon: 'users' as const, label: 'For', value: 'Families with children aged 2–11' },
];

const schedule = [
  { time: '8:30 – 9:00 AM', title: 'Registration & badge pick-up' },
  { time: '9:00 – 9:10 AM', title: 'Welcome' },
  { time: '9:15 – 9:50 AM', title: 'Open House presentation', note: 'ISPG overview, programmes and facilities.' },
  { time: '9:50 – 10:00 AM', title: 'Change into sports kit', note: 'Students get ready for the activity session.' },
  { time: '10:00 – 11:30 AM', title: 'Sports activity finale', note: 'Swimming, rock climbing and Montessori stations.' },
  { time: '11:30 AM – 12:00 PM', title: 'Prize-giving & group photo' },
];

const gallery = [
  { src: '/media/site/openhouse-badges.webp', alt: 'Name badges ready for ISPG Open House guests' },
  { src: '/media/site/openhouse-stalls.webp', alt: 'Activity stalls set up for ISPG Open House' },
  { src: '/media/site/badges.webp', alt: 'Visitor badges at ISPG Open House' },
  { src: '/media/site/presentation.webp', alt: 'ISPG staff presenting to Open House visitors' },
  { src: '/media/site/openhouse-crowd.webp', alt: 'Families gathered at ISPG Open House' },
  { src: '/media/site/openhouse-play.webp', alt: 'Children playing at ISPG Open House' },
  { src: '/media/site/climbing-2.webp', alt: 'A child rock climbing at ISPG Open House' },
  { src: '/media/site/openhouse-stretch.webp', alt: 'Children stretching during an ISPG Open House activity' },
  { src: '/media/site/openhouse-climb-2.webp', alt: 'A child on the climbing wall at ISPG Open House' },
  { src: '/media/site/openhouse-swim.webp', alt: 'A child swimming at ISPG Open House' },
  { src: '/media/site/swim-joy.webp', alt: 'A child enjoying the pool at ISPG Open House' },
  { src: '/media/site/openhouse-splash.webp', alt: 'Children splashing in the pool at ISPG Open House' },
  { src: '/media/site/openhouse-blocks.webp', alt: 'A child building with blocks at ISPG Open House' },
  { src: '/media/site/openhouse-family.webp', alt: 'A family exploring campus at ISPG Open House' },
  { src: '/media/site/openhouse-family-2.webp', alt: 'Parents and children at ISPG Open House' },
];
---

<BaseLayout
  title="Open House"
  description={`Experience ${cam('the Cambridge curriculum', 'our international curriculum')} brought to life — watch your child climb, swim and discover learning that feels like play.`}
  noindex
  image="/media/site/openhouse-climbing.webp"
>
  <section class="ohero">
    <div class="ohero__media">
      <Image
        src={img('/media/site/openhouse-climbing.webp')!}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="ohero__scrim"></div>
    </div>
    <div class="container ohero__inner">
      <Eyebrow color="var(--sky-300)" align="center">Open House · ISPG Koh Phangan</Eyebrow>
      <h1 class="ohero__title">Learning that feels like <em>play</em></h1>
      <p class="ohero__lead">
        Experience {cam('our Cambridge curriculum', 'our international curriculum')} brought to life. Watch your child climb, swim
        and discover — while you tour the campus and meet the educators.
      </p>
      <Button variant="primary" size="lg" href="#register">Save your family’s spot</Button>

      <ul class="ohero__facts">
        {facts.map((f) => (
          <li>
            <Icon name={f.icon} size={17} />
            <span><span class="ohero__flabel">{f.label}</span>{f.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------- film */}
  <section class="section">
    <div class="container film">
      <div data-reveal><GumletVideo id={embeds.openHouseFilm} title="ISPG Open House film" /></div>
    </div>
  </section>

  {/* ------------------------------------------------------------ FLAIR */}
  <section class="section navy">
    <div class="container">
      <div data-reveal>
        <SectionHeading
          align="center"
          tone="dark"
          size="sm"
          eyebrow="What you'll see"
          eyebrowColor="var(--sky-300)"
          title="An Open House where your child <em>participates</em>"
          lead="Your family explores our FLAIR approach while your child takes part in real ISPG activities — rock climbing, swimming and Montessori learning stations."
        />
      </div>
      <ul class="pillars">
        {pillars.map((p, i) => (
          <li data-reveal data-reveal-delay={i * 80}>
            <span class="pillars__letter" style={`background:${p.accent}`} aria-hidden="true">{p.letter}</span>
            <span class="pillars__name">{p.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------- schedule */}
  <section class="section">
    <div class="container">
      <div data-reveal>
        <SectionHeading size="sm" eyebrow="The morning" title="Hour by <em>hour</em>" />
      </div>
      <ol class="sched">
        {schedule.map((s, i) => (
          <li data-reveal data-reveal-delay={i * 60}>
            <time class="sched__time">{s.time}</time>
            <div>
              <h3 class="sched__title">{s.title}</h3>
              {s.note && <p class="sched__note">{s.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------------- gallery */}
  <section class="section alt">
    <div class="container">
      <div data-reveal>
        <SectionHeading size="sm" eyebrow="Last time" title="From our <em>previous</em> Open House" />
      </div>
      <ul class="gallery">
        {gallery.map((g, i) => (
          <li data-reveal data-reveal-delay={Math.min(i, 8) * 40}>
            <Image
              src={img(g.src)!}
              alt={g.alt}
              widths={[400, 800]}
              sizes="(min-width: 900px) 400px, 90vw"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------- register */}
  <section class="section navy-deep" id="register">
    <div class="container reg">
      <div data-reveal>
        <SectionHeading
          tone="dark"
          size="sm"
          eyebrow="Register"
          eyebrowColor="var(--sky-300)"
          title="Spaces are <em>limited</em>"
          lead="Secure your family's spot for a morning of swimming, climbing and Montessori activities."
        />
        <ul class="reg__contact">
          <li><Icon name="phone" size={17} /><a href={contact.phoneHref}>{contact.phoneDisplay}</a></li>
          <li><Icon name="mail" size={17} /><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        </ul>
      </div>
      <div data-reveal data-reveal-delay="90">
        <DeftForm formId={embeds.openHouseForm} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ohero { position: relative; background: var(--navy-800); isolation: isolate; }
  .ohero__media { position: absolute; inset: 0; overflow: hidden; z-index: -1; }
  .ohero__media img { width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }
  .ohero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13,41,66,.68) 0%, rgba(13,41,66,.4) 42%, rgba(13,41,66,.85) 100%);
  }
  .ohero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-5);
    padding-block: calc(var(--header-h) + clamp(3rem, 8vw, 6rem)) clamp(3rem, 7vw, 5rem);
  }
  .ohero__title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--fs-display-1);
    line-height: 1.05;
    color: #fff;
  }
  .ohero__title em { font-style: italic; }
  .ohero__lead { margin: 0; max-width: 54ch; font-size: var(--fs-lead); line-height: 1.55; color: rgba(255,255,255,.9); }

  .ohero__facts {
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: var(--sp-6) 0 0;
    border-top: 1px solid rgba(255,255,255,.2);
    display: flex;
    gap: clamp(var(--sp-6), 4vw, var(--sp-12));
    flex-wrap: wrap;
    justify-content: center;
  }
  .ohero__facts li { display: flex; gap: 10px; align-items: center; color: #fff; font-size: var(--fs-sm); }
  .ohero__facts :global(.icon) { color: var(--sky-300); }
  .ohero__flabel {
    display: block;
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--sky-300);
    margin-bottom: 2px;
  }
  .ohero__facts li > span { text-align: left; }

  .film { max-width: 900px; }

  .pillars {
    list-style: none;
    margin: var(--sp-10) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-4);
  }
  .pillars li { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  .pillars__letter {
    width: 52px; height: 52px; border-radius: 50%; color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: var(--fw-bold); font-size: 26px;
  }
  .pillars__name { font-size: var(--fs-sm); color: #fff; font-weight: var(--fw-semibold); line-height: 1.3; }

  .sched { list-style: none; margin: var(--sp-10) 0 0; padding: 0; display: grid; gap: 0; }
  .sched li {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--sp-6);
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--border-hairline);
  }
  .sched li:last-child { border-bottom: 1px solid var(--border-hairline); }
  .sched__time { font-weight: var(--fw-bold); color: var(--accent-primary); font-size: var(--fs-sm); letter-spacing: 0.02em; padding-top: 3px; }
  .sched__title { margin: 0; font-family: var(--font-display); font-size: 1.35rem; color: var(--navy-700); font-weight: var(--fw-semibold); }
  .sched__note { margin: 4px 0 0; color: var(--text-muted); font-size: var(--fs-sm); }

  .gallery {
    list-style: none;
    margin: var(--sp-10) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-3);
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--r-md);
    display: block;
    box-shadow: var(--shadow-xs);
    transition: transform var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  }
  .gallery img:hover { transform: scale(1.04); box-shadow: var(--shadow-md); }

  .reg { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(var(--sp-10), 5vw, var(--sp-16)); align-items: start; }
  .reg__contact { list-style: none; margin: var(--sp-8) 0 0; padding: 0; display: grid; gap: 12px; }
  .reg__contact li { display: flex; gap: 12px; align-items: center; color: var(--text-on-navy); }
  .reg__contact :global(.icon) { color: var(--sky-300); }
  .reg__contact a { color: var(--text-on-navy); text-decoration: none; }
  .reg__contact a:hover { color: var(--sky-300); }

  @media (max-width: 1000px) { .gallery { grid-template-columns: repeat(4, 1fr); } .pillars { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) { .reg { grid-template-columns: 1fr; } }
  @media (max-width: 700px) {
    .sched li { grid-template-columns: 1fr; gap: var(--sp-2); }
    .gallery { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 520px) { .pillars { grid-template-columns: repeat(2, 1fr); } }
</style>
